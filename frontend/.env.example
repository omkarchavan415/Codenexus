# Base URL of the API. Leave empty in local dev (Vite proxies /api) and in docker-compose (nginx proxies /api).
# Set it to your deployed API origin when the frontend is hosted separately, e.g. https://codenexus-api.onrender.com
VITE_API_URL=
# Dev server only: where Vite proxies /api
VITE_PROXY_TARGET=http://localhost:5000
