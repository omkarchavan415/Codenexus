# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB (local, docker-compose service name "mongo", or an Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/codenexus

# Auth: use long random values, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Gemini (optional). Leave blank to run on the approved question bank only.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000

# Redis (optional). Set it to enable the BullMQ generation queue and shared cache, e.g. redis://localhost:6379
REDIS_URL=

# First admin, used only by `node scripts/createAdmin.js`
ADMIN_EMAIL=
ADMIN_PASSWORD=
