# Used by docker-compose.yml. Copy to .env and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:8080

# Optional: enables AI question generation (admin review required before students see anything)
GEMINI_API_KEY=
GEMINI_MODEL=
